# Local mode is the safe default. Copy this file to .env and change only what you use.
RESUMEIQ_DATA_DIR=./data
RESUMEIQ_DEMO_DATA_DIR=./data/demo
RESUMEIQ_ENVIRONMENT=development
RESUMEIQ_DEMO_MODE=false
RESUMEIQ_AUTH_REQUIRED=false
RESUMEIQ_ALLOWED_TENANT_ID=
RESUMEIQ_MAX_FILE_MB=10
RESUMEIQ_RETENTION_DAYS=30
RESUMEIQ_ANONYMOUS_DEFAULT=false
RESUMEIQ_SEMANTIC_PROVIDER=tfidf
RESUMEIQ_SENTENCE_MODEL=all-MiniLM-L6-v2

# Optional Azure features (all disabled by default)
RESUMEIQ_USE_AZURE_DOCUMENT_INTELLIGENCE=false
RESUMEIQ_USE_AZURE_LANGUAGE=false
RESUMEIQ_USE_AZURE_BLOB=false
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
AZURE_LANGUAGE_ENDPOINT=
AZURE_LANGUAGE_KEY=
# Preferred in Azure: use this URL with the Web App's managed identity.
AZURE_STORAGE_ACCOUNT_URL=
# Local-only fallback when managed identity is unavailable; never commit a real value.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=resumes

